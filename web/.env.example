VITE_API_BASE_URL=https://api.cleanenergyanalytics.co.uk

# Optional — unset shows a graceful placeholder on Site Detail instead of
# a broken map embed. Needs the Maps Embed API enabled on that key.
VITE_GOOGLE_MAPS_API_KEY=

# The broker address a physical datalogger should actually dial —
# NOT the same as the backend's internal MQTT_BROKER_URL (which points
# at the docker-compose service name "mosquitto", unreachable from
# outside the server). Used only to build the QR code / setup text shown
# once at device registration (DeviceQRCode.tsx) — optional, that panel
# just omits the broker address if unset. Example:
# VITE_MQTT_PUBLIC_BROKER_URL=mqtt://mqtt.cleanenergyanalytics.co.uk:1883
VITE_MQTT_PUBLIC_BROKER_URL=
