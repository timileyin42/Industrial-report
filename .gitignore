mosquitto/config/passwd
mosquitto/data/
mosquitto/log/
*.log

# Real secrets — .env.example is the committed template, .env itself
# (and web/.env, which already has its own untracked convention) never is.
.env

# OS cruft
.DS_Store

# Compiled build artifacts (e.g. `go build -o ingestor ./cmd/ingestor`)
/ingestor
/api
/seed-operator

# Design-export archive — already unzipped into design/
*.zip

# Stitch design export — kept locally as the design-token/screen reference,
# never pushed to GitHub (large binary screenshots + not meant to be public)
design/

# Agent instruction/meta files — internal working docs, not meant to be
# public on GitHub. Kept locally.
AGENTS.md
CLAUDE.md
SKILL.md

# Phase 4 — local backups and dev-only TLS certs/keys, never committed
backups/
mosquitto/config/certs/
loadtest-devices.csv

# Raw design reference media (multi-MB videos/images) — kept locally as
# source material for the frontend redesign, never committed directly;
# only optimized/compressed derivatives that actually ship get added
# under web/src/assets once built into the app.
raw-assets/
