FROM golang:1.24-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/solarman-sync ./cmd/solarman-sync

FROM alpine:3.20
RUN apk add --no-cache ca-certificates
COPY --from=builder /out/solarman-sync /usr/local/bin/solarman-sync
ENTRYPOINT ["/usr/local/bin/solarman-sync"]
