FROM golang:1.24-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/pvpro-sync ./cmd/pvpro-sync

FROM alpine:3.20
RUN apk add --no-cache ca-certificates
COPY --from=builder /out/pvpro-sync /usr/local/bin/pvpro-sync
ENTRYPOINT ["/usr/local/bin/pvpro-sync"]
