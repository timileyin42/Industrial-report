# Copy to .env and fill in. See README/CLAUDE.md for what each phase
# actually needs — nothing here is loaded automatically by Go itself;
# docker-compose reads this file via env_file, or export these yourself
# for `go run` against local infra.

# --- Database (required) ---
DATABASE_URL=postgres://zgnis:zgnis_dev_only@timescaledb:5432/zgnis_solar?sslmode=disable
DATABASE_SSLMODE=disable
# Must match the password in DATABASE_URL above — docker-compose.yml's
# timescaledb service reads this to set the container's actual Postgres
# password. Only needs setting explicitly if you changed it from the
# zgnis_dev_only default (e.g. in production).
POSTGRES_PASSWORD=zgnis_dev_only

# --- Auth (required) ---
# Generate: openssl rand -base64 32
JWT_SECRET=dev-only-change-me

# --- Fleet/health tuning (optional, defaults shown) ---
ONLINE_THRESHOLD_MINUTES=10
EXPECTED_READING_INTERVAL_MINUTES=5
COVERAGE_WINDOW_HOURS=24

# --- Emissions (optional — confirm with client before setting for real) ---
GRID_COUNTRY=NG

# --- Email — invites/password reset (optional, no-op sender if unset) ---
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
APP_BASE_URL=http://localhost:5173

# --- Export storage — Cloudflare R2 (optional, exports fail clearly if unset) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- API TLS (optional, only takes effect if BOTH are set) ---
# Leave both blank when Cloudflare (proxy/Tunnel) terminates TLS at the
# edge in front of this origin — that's this deployment's setup. Only
# fill these in if the API container itself needs to present its own
# cert directly to the internet (no Cloudflare in front).
API_TLS_CERT_FILE=
API_TLS_KEY_FILE=

# --- CORS (required — no wildcard per CLAUDE.md; comma-separated if more than one) ---
DASHBOARD_ORIGINS=http://localhost:5173

# --- MQTT (required by the ingestor) ---
MQTT_BROKER_URL=tcp://mosquitto:1883
MQTT_USERNAME=ingestor-service
MQTT_PASSWORD=supersecret
MQTT_TLS_CA_CERT=

# --- MQTT broker admin (optional, but required for automatic device
# credential sync — see internal/mqttadmin/dynsec.go). Without these,
# device registration/rotation/revocation still works, but you're back
# to manually running mosquitto commands to sync each device's
# credential into the broker. MOSQUITTO_DYNSEC_PASSWORD sets the admin
# password on the broker's very first start; MQTT_ADMIN_USERNAME/
# PASSWORD is what the API connects to the broker with as that admin —
# they must describe the same account (username is always "admin" on
# first bootstrap; only the password is configurable here). Generate a
# real password with: openssl rand -base64 24
MOSQUITTO_DYNSEC_PASSWORD=dev-only-change-me
MQTT_ADMIN_USERNAME=admin
MQTT_ADMIN_PASSWORD=dev-only-change-me

# --- Frontend build args — read by `docker compose build web` (NOT the
# same as web/.env, which only affects `npm run dev`; keep both in sync
# manually). See ENV_SETUP.md §2/§5. ---
VITE_API_BASE_URL=http://localhost:8080
VITE_GOOGLE_MAPS_API_KEY=
VITE_MQTT_PUBLIC_BROKER_URL=
